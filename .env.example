# Server Configuration
PORT=3000
NODE_ENV=development

# Neon PostgreSQL Database (Recommended: paste your Neon connection string in AI Studio Secrets)
NEON_DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require"

# Database (MongoDB Atlas connection string - optional fallback; uses persistent local JSON store when omitted)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/lingualearn?retryWrites=true&w=majority"

# Authentication
JWT_SECRET="replace_with_a_strong_64_char_random_secret"
JWT_EXPIRES_IN="7d"

# Frontend / Deployment URLs
VITE_API_URL="/api"
CLIENT_URL="http://localhost:3000"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
